class Sorts {

    static void bubble(int a[]){
        for(int i=0;i<a.length-1;i++)
            for(int j=0;j<a.length-i-1;j++)
                if(a[j]>a[j+1]){
                    int t=a[j]; a[j]=a[j+1]; a[j+1]=t;
                }
    }

    static void insertion(int a[]){
        for(int i=1;i<a.length;i++){
            int k=a[i], j=i-1;
            while(j>=0 && a[j]>k) a[j+1]=a[j--];
            a[j+1]=k;
        }
    }

    static void selection(int a[]){
        for(int i=0;i<a.length-1;i++){
            int m=i;
            for(int j=i+1;j<a.length;j++)
                if(a[j]<a[m]) m=j;
            int t=a[i]; a[i]=a[m]; a[m]=t;
        }
    }

    static void quick(int a[],int l,int h){
        if(l<h){
            int p=part(a,l,h);
            quick(a,l,p-1); quick(a,p+1,h);
        }
    }
    static int part(int a[],int l,int h){
        int p=a[h],i=l-1;
        for(int j=l;j<h;j++)
            if(a[j]<p){
                int t=a[++i]; a[i]=a[j]; a[j]=t;
            }
        int t=a[i+1]; a[i+1]=a[h]; a[h]=t;
        return i+1;
    }

    static void mergeSort(int a[],int l,int r){
        if(l<r){
            int m=(l+r)/2;
            mergeSort(a,l,m); mergeSort(a,m+1,r);
            merge(a,l,m,r);
        }
    }
    static void merge(int a[],int l,int m,int r){
        int i=l,j=m+1,k=0,b[]=new int[r-l+1];
        while(i<=m && j<=r)
            b[k++]=(a[i]<a[j])?a[i++]:a[j++];
        while(i<=m) b[k++]=a[i++];
        while(j<=r) b[k++]=a[j++];
        for(i=l,k=0;i<=r;i++) a[i]=b[k++];
    }

    static void print(int a[]){
        for(int x:a) System.out.print(x+" ");
        System.out.println();
    }

    public static void main(String[] args){
        int a[]={5,3,8,4,2};

        int b[]=a.clone(); bubble(b); print(b);
        int c[]=a.clone(); insertion(c); print(c);
        int d[]=a.clone(); selection(d); print(d);
        int e[]=a.clone(); quick(e,0,e.length-1); print(e);
        int f[]=a.clone(); mergeSort(f,0,f.length-1); print(f);
    }
}
